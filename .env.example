# Google Sheets integration (Live Availability Dashboard + Units)
#
# Zero-setup path (default, no Service Account needed): just set the sheet
# ID below. The sheet must be shared as "Anyone with the link can view",
# and read via its public CSV export — see src/services/googleSheets.ts.
# If left empty, site.config.ts already falls back to the project's live
# sheet, and if that's also unreachable the site falls back further to
# built-in sample data — it never breaks.

GOOGLE_SHEET_ID=

# Optional (advanced): only needed if you'd rather keep the sheet private
# instead of sharing it via link. When both of these are set, the site
# uses a Google Service Account instead of the public CSV export.
GOOGLE_CLIENT_EMAIL=
# Keep the literal \n line breaks in the private key (wrap in quotes).
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional: override the default sheet tab name / range.
# Expected columns, in order:
# Unit ID | Status | Area | Price | Bedrooms | Bathrooms | Parking | Roof | Image | PDF
GOOGLE_SHEET_RANGE=Units!A2:J100
