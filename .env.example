# ---------------------------------------------------------------------------
# PANTHER — environment template. Copy to .env.local and fill in.
# Never commit .env.local or any real key.
# ---------------------------------------------------------------------------

# Absolute origin of the deployment. Used by metadataBase, canonical URLs,
# hreflang alternates, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase — Project Settings → API. The app builds and runs without these;
# any feature that needs the database fails with an actionable message until
# they are set.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Must never carry a NEXT_PUBLIC_ prefix and must never reach the
# browser. It BYPASSES Row Level Security, so it is used only where an
# operation cannot be expressed under RLS (inviting a user, assigning a role).
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection, used only by the local tooling:
#   npm run db:types -- "$SUPABASE_DB_URL"
#   npm run db:test  -- "$SUPABASE_DB_URL"
# Never referenced by the application at runtime.
SUPABASE_DB_URL=

# ---------------------------------------------------------------------------
# Analytics — wired up in Phase 06. IDs are read from the environment so no
# tracking identifier is ever hardcoded in a component.
# ---------------------------------------------------------------------------

# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# NEXT_PUBLIC_GTM_ID=
# NEXT_PUBLIC_META_PIXEL_ID=
