# ---------------------------------------------------------------------------
# PANTHER — environment template. Copy to .env.local and fill in.
# Never commit .env.local or any real key.
# ---------------------------------------------------------------------------

# Absolute origin of the deployment. Used by metadataBase, canonical URLs,
# hreflang alternates, robots.txt and sitemap.xml.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase — wired up in Phase 03. Values come from the project dashboard.
# ---------------------------------------------------------------------------

# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Must never be prefixed with NEXT_PUBLIC_ and must never reach
# the browser. Used solely for administrative operations in Server Actions.
# SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Analytics — wired up in Phase 06. IDs are read from the environment so no
# tracking identifier is ever hardcoded in a component.
# ---------------------------------------------------------------------------

# NEXT_PUBLIC_GA_MEASUREMENT_ID=
# NEXT_PUBLIC_GTM_ID=
# NEXT_PUBLIC_META_PIXEL_ID=
