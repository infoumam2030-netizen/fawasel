# Google Sheets integration (Live Availability Dashboard + Units)
# Create a Google Cloud service account, share the target sheet with its
# client email (Viewer access), then fill in the values below.
# If these are left empty, the site automatically falls back to built-in
# sample data so the project still runs fully in local/demo environments.

GOOGLE_SHEET_ID=
GOOGLE_CLIENT_EMAIL=
# Keep the literal \n line breaks in the private key (wrap in quotes).
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional: override the default sheet range (Sheet name + column range).
# Expected columns, in order:
# Unit ID | Status | Area | Price | Bedrooms | Bathrooms | Parking | Roof | Image | PDF
GOOGLE_SHEET_RANGE=Units!A2:J100
