# Google Sheets integration (unit availability)
#
# Zero-setup path (default, no Service Account needed): set the sheet ID
# below, sharing the sheet as "Anyone with the link can view", and it's
# read via its public CSV export — see src/services/google-sheets.ts.
# If left empty, the site falls back to built-in sample data (14 units)
# so it stays fully functional and demonstrable without any setup.

GOOGLE_SHEET_ID=

# Optional (advanced): only needed if you'd rather keep the sheet private
# instead of sharing it via link. When both of these are set, the site
# uses a Google Service Account instead of the public CSV export.
GOOGLE_CLIENT_EMAIL=
# Keep the literal \n line breaks in the private key (wrap in quotes).
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional: override the default sheet tab name / range.
# Expected columns, in order:
# Unit ID | Name | Type (شقة/دوبلكس) | Area | Price | Status | Floor |
# Features (";"-separated) | Images (";"-separated URLs) | Floor plan image URL
GOOGLE_SHEET_RANGE=Units!A2:J100
